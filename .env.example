# Trading 212 API Credentials
TRADING212_API_CLIENT_ID=your_trading212_client_id
TRADING212_API_CLIENT_SECRET=your_trading212_client_secret

# Actual HTTP API Credentials & Configuration
ACTUAL_API_URL=https://api.actual.int.alexmmd.com
ACTUAL_API_KEY=your_actual_api_key
ACTUAL_BUDGET_SYNC_ID=your_budget_sync_id
ACTUAL_ACCOUNT_ID=your_actual_account_id
# Optional: fallback to resolve account ID by name if ACTUAL_ACCOUNT_ID is not provided
# ACTUAL_ACCOUNT_NAME="Trading 212"
# Optional: password for end-to-end encrypted budgets
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=your_budget_encryption_password

# Background Sync & Scheduling
# Configurable frequency for SyncAllJob (defaults to daily).
# Accepts: daily, hourly, weekly, or Fugit/cron expressions like "every 6 hours", "0 0 * * *"
SYNC_FREQUENCY=daily

# Mission Control Jobs UI (Optional Basic Authentication)
# If set, protects the dashboard at /jobs with HTTP Basic Authentication.
# MISSION_CONTROL_USER=admin
# MISSION_CONTROL_PASSWORD=your_password
